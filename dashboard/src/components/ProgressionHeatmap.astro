---
import Crest from "./Crest.astro";
interface Team { team_name: string; team_tla: string | null; crest: string | null; reach: number[] }
const { levels, teams } = Astro.props as { levels: string[]; teams: Team[] };
const cell = (p: number) => `background: color-mix(in srgb, var(--accent) ${Math.round(p * 100)}%, var(--paper))`;
const fg = (p: number) => (p > 0.55 ? "var(--paper-on-accent)" : "var(--ink-soft)");
---

<figure class="heat">
  <div class="heat__grid" role="table" aria-label="Probabilité d'atteindre chaque tour, par équipe">
    <div class="heat__row heat__head mono" role="row">
      <span class="heat__team" role="columnheader">Équipe</span>
      {levels.map((l) => <span class="heat__cell" role="columnheader">{l}</span>)}
    </div>
    {teams.map((t) => (
      <div class:list={["heat__row", { hi: t.team_name === "Spain" }]} role="row">
        <span class="heat__team" role="rowheader">
          <Crest url={t.crest} tla={t.team_tla} size={16} />
          <span class="heat__tla mono">{t.team_tla ?? t.team_name}</span>
        </span>
        {t.reach.map((p) => (
          <span class="heat__cell mono" style={`${cell(p)}; color:${fg(p)}`}>{Math.round(p * 100)}</span>
        ))}
      </div>
    ))}
  </div>
  <figcaption class="heat__cap mono">
    Chaque case = probabilité (%) d'atteindre ce tour, estimée sur 10 000 tournois simulés depuis les 16es.
  </figcaption>
</figure>

<style>
  .heat { margin: 0; overflow-x: auto; }
  .heat__grid { min-width: 34rem; }
  .heat__row { display: grid; grid-template-columns: 6.5rem repeat(6, 1fr); gap: 2px; margin-bottom: 2px; align-items: center; }
  .heat__head { margin-bottom: 0.4rem; }
  .heat__head .heat__cell { background: none; color: var(--ink-faint); font-size: var(--mono-xs); letter-spacing: 0.03em; text-align: center; padding: 0.2rem 0; }
  .heat__team { display: flex; align-items: center; gap: 0.4rem; font-size: var(--mono-sm); }
  .heat__tla { color: var(--ink-soft); }
  .heat__cell { text-align: center; padding: 0.5rem 0; font-size: var(--mono-sm); font-variant-numeric: tabular-nums; }
  .heat__row.hi .heat__tla { color: var(--ink); font-weight: 700; }
  .heat__row.hi .heat__cell { outline: 1px solid var(--gold); outline-offset: -1px; }
  .heat__cap { margin-top: 0.7rem; font-size: var(--mono-xs); color: var(--ink-faint); line-height: 1.5; }
</style>
