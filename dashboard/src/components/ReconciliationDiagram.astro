---
// Visual of the end-to-end integrity test: two independently-built standings
// converge into a row-by-row comparison; any divergence breaks the build.
// Replaces a paragraph of prose with a diagram that shows the idea at a glance.
---
<div class="rec" role="img"
     aria-label="Deux classements — l'un recalculé depuis les résultats, l'autre officiel via l'API — sont comparés ligne à ligne ; ils coïncident sur 48 équipes sur 48, sinon le pipeline échoue.">
  <div class="rec__sources">
    <div class="rec__src rec__src--computed">
      <span class="rec__badge mono">Recalculé</span>
      <span class="rec__srcname mono">fct_group_standings</span>
      <span class="rec__srcnote">depuis les seuls résultats des matchs, règles FIFA</span>
    </div>
    <div class="rec__src rec__src--official">
      <span class="rec__badge mono">Officiel</span>
      <span class="rec__srcname mono">stg_standings</span>
      <span class="rec__srcnote">classement publié par l'API</span>
    </div>
  </div>

  <div class="rec__join mono" aria-hidden="true">
    <span class="rec__arm rec__arm--l"></span>
    <span class="rec__arm rec__arm--r"></span>
  </div>

  <div class="rec__compare">
    <span class="rec__op mono">comparaison ligne à ligne</span>
    <span class="rec__keys mono">points · diff · buts · position</span>
  </div>

  <div class="rec__down mono" aria-hidden="true">↓</div>

  <div class="rec__result">
    <span class="rec__count">48<span class="rec__slash">/</span>48</span>
    <span class="rec__ok mono">coïncident ✓</span>
    <span class="rec__else mono">une divergence ⇒ le build échoue</span>
  </div>
</div>

<style>
  .rec { max-width: 40rem; }
  .rec__sources { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .rec__src { padding: 0.9rem 1rem; border: 1px solid var(--line-strong); background: var(--paper-raised); }
  .rec__src--computed { border-top: 3px solid var(--accent); }
  .rec__src--official { border-top: 3px solid var(--teal); }
  .rec__badge { display: inline-block; font-size: var(--mono-xs); letter-spacing: 0.1em; text-transform: uppercase; }
  .rec__src--computed .rec__badge { color: var(--accent); }
  .rec__src--official .rec__badge { color: var(--teal); }
  .rec__srcname { display: block; margin-top: 0.35rem; font-size: 0.9rem; font-weight: 600; color: var(--ink); }
  .rec__srcnote { display: block; margin-top: 0.3rem; font-size: var(--mono-xs); color: var(--ink-soft); line-height: 1.4; font-family: var(--mono); }

  .rec__join { position: relative; height: 1.4rem; }
  .rec__arm { position: absolute; top: 0; width: 50%; height: 100%; }
  .rec__arm--l { left: 0; border-right: 1px solid var(--line-strong); border-bottom: 1px solid var(--line-strong); }
  .rec__arm--r { right: 0; border-left: 1px solid var(--line-strong); border-bottom: 1px solid var(--line-strong); }

  .rec__compare { text-align: center; padding: 0.85rem 1rem; border: 1px solid var(--ink); background: var(--paper); }
  .rec__op { display: block; font-size: 0.9rem; font-weight: 600; letter-spacing: 0.02em; color: var(--ink); font-family: var(--sans); }
  .rec__keys { display: block; margin-top: 0.25rem; font-size: var(--mono-xs); color: var(--ink-faint); }

  .rec__down { text-align: center; font-size: 1.1rem; color: var(--ink-faint); line-height: 1.6; }

  .rec__result { text-align: center; padding: 1.1rem 1rem; background: var(--ink); color: var(--paper-on-accent); }
  .rec__count { display: block; font-family: var(--sans); font-size: clamp(2.2rem, 7vw, 3.2rem); font-weight: 800; letter-spacing: -0.02em; color: var(--gold-bright); line-height: 1; }
  .rec__slash { color: rgba(246,239,230,0.4); font-weight: 400; margin: 0 0.05em; }
  .rec__ok { display: block; margin-top: 0.35rem; font-size: var(--mono-sm); letter-spacing: 0.08em; text-transform: uppercase; color: var(--paper-on-accent); }
  .rec__else { display: block; margin-top: 0.3rem; font-size: var(--mono-xs); color: rgba(246,239,230,0.6); }

  @media (max-width: 520px) {
    .rec__sources { grid-template-columns: 1fr; }
    .rec__join { display: none; }
    .rec__src { border-top-width: 3px; }
  }
</style>
