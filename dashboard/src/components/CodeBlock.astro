---
// A dark code card with a filename tab — the terminal signature, applied to
// the real implementation. Content is passed as a slot (kept verbatim).
const { file, lang = "" } = Astro.props as { file: string; lang?: string };
---
<figure class="code">
  <figcaption class="code__bar mono">
    <span class="code__file">{file}</span>
    {lang && <span class="code__lang">{lang}</span>}
  </figcaption>
  <pre class="code__pre mono"><slot /></pre>
</figure>

<style>
  .code { margin: 0; border: 1px solid var(--accent-deep); background: var(--ink); }
  .code__bar { display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0.9rem; border-bottom: 1px solid #2a2620; color: rgba(246,239,230,0.65); font-size: var(--mono-xs); letter-spacing: 0.04em; }
  .code__file { color: var(--gold-bright); }
  .code__lang { text-transform: uppercase; }
  .code__pre { margin: 0; padding: 1rem 1.1rem; overflow-x: auto; color: #e9e3d6; font-size: 0.8rem; line-height: 1.65; tab-size: 2; }
  .code__pre :global(b) { color: var(--accent-bright); font-weight: 400; }
  .code__pre :global(i) { color: rgba(246,239,230,0.5); font-style: normal; }
  .code__pre :global(.s) { color: #b9d5a8; }
</style>
