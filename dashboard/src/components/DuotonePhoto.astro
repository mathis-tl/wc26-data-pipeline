---
// Duotone photo band. Every photo is pushed through the same pitch/paper
// duotone (CSS blend) so the treatment — not the source image — carries the
// identity, and the whole site reads as one chromatic world.
const {
  src,
  alt,
  height = "clamp(15rem, 34vw, 26rem)",
  caption,
} = Astro.props as { src: string; alt: string; height?: string; caption?: string };
---

<figure class="duo" style={`--duo-h:${height}`}>
  <div class="duo__frame">
    <img class="duo__img" src={src} alt={alt} loading="lazy" decoding="async" />
    <span class="duo__wash" aria-hidden="true"></span>
    <span class="duo__grain" aria-hidden="true"></span>
  </div>
  {caption ? <figcaption class="duo__cap mono">{caption}</figcaption> : null}
</figure>

<style>
  .duo { margin: 0; }
  .duo__frame {
    position: relative; overflow: hidden;
    height: var(--duo-h);
    background: var(--pitch);
    isolation: isolate;
  }
  .duo__img {
    width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(1) contrast(1.06) brightness(1.02);
    mix-blend-mode: multiply;
  }
  /* lifts the blacks toward paper so it's a green→paper duotone, not black→green */
  .duo__wash {
    position: absolute; inset: 0; z-index: 1;
    background: var(--paper);
    mix-blend-mode: screen;
    opacity: 0.72;
  }
  .duo__grain {
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background-image: radial-gradient(rgba(7, 42, 28, 0.5) 0.5px, transparent 0.6px);
    background-size: 3px 3px;
    opacity: 0.18;
    mix-blend-mode: multiply;
  }
  .duo__cap {
    font-size: var(--mono-xs); letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--ink-faint); margin-top: 0.55rem;
  }
</style>
