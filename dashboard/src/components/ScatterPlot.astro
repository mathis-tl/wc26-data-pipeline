---
// Attack × defense scatter of every team, from the Poisson model. The elite
// corner (top-right) is strong attack AND strong defense. Spain is highlighted.
// A genuine analytical view — not something a results app shows.
//
// Labels are placed by a small greedy de-collision pass: each label tries eight
// positions around its dot and takes the first that clears every already-placed
// label AND the two axis captions; displaced labels get a thin leader line back
// to their dot. This kills the ARG/BEL overlap and the ENG-on-the-axis clash.
interface Pt { x: number; y: number; label: string; tla: string | null; highlight?: boolean; show?: boolean }
const {
  points, xLabel = "Attaque →", yLabel = "Défense →", xRef = 0, yRef = 0, caption, ariaLabel,
  scale = false,
} = Astro.props as {
  points: Pt[]; xLabel?: string; yLabel?: string; xRef?: number; yRef?: number;
  caption?: string; ariaLabel?: string; scale?: boolean;
};

const xs = points.map((p) => p.x), ys = points.map((p) => p.y);
const pad = 0.15;
const xmin = Math.min(...xs) - pad, xmax = Math.max(...xs) + pad;
const ymin = Math.min(...ys) - pad, ymax = Math.max(...ys) + pad;
const W = 100, H = 66;
// scale mode widens the left margin (vertical y-title + numeric tick labels) and
// the bottom (x-title sitting on the axis) — Fig 6 uses it so magnitudes are
// readable; the attack×defense quadrant plot (Fig 1) keeps the tight layout with
// its labels at the average-team cross, where the model's 0-centred units read
// as "more / better →" rather than as meaningful numbers.
const m = scale ? { l: 9, r: 4, t: 5, b: 9 } : { l: 4, r: 4, t: 5, b: 6 };
const sx = (x: number) => m.l + ((x - xmin) / (xmax - xmin)) * (W - m.l - m.r);
const sy = (y: number) => (H - m.b) - ((y - ymin) / (ymax - ymin)) * (H - m.t - m.b);
const x0 = sx(xRef), y0 = sy(yRef); // reference lines: average team (0) unless the dataset supplies its own mean
// light "nice" numeric ticks for the y-axis in scale mode (Fig 6: save %)
function niceTicks(lo: number, hi: number, target = 4): number[] {
  const raw = (hi - lo) / target;
  const mag = 10 ** Math.floor(Math.log10(raw));
  const step = mag * ([1, 2, 2.5, 5, 10].find((s) => s * mag >= raw) ?? 10);
  const out: number[] = [];
  for (let v = Math.ceil(lo / step) * step; v <= hi; v += step) out.push(Math.round(v * 100) / 100);
  return out;
}
const yticks = scale ? niceTicks(ymin, ymax) : [];

const capText = caption ?? "Chaque point = une équipe · position = force d'attaque et de défense estimées (modèle) · lignes = l'équipe moyenne · étiquetés : le top 5, l'Espagne, la meilleure attaque et l'anomalie défensive";
const ariaText = ariaLabel ?? "Nuage de points attaque contre défense des équipes ; l'Espagne se situe dans le coin d'élite (forte attaque et forte défense).";

// --- label placement -------------------------------------------------------
const FS = 1.7;                 // label font-size (matches .lbl)
const CH = FS * 0.62;           // monospace char advance
const LH = FS * 1.1;            // label line height
type Box = { x0: number; y0: number; x1: number; y1: number };
const overlaps = (a: Box, b: Box) => a.x0 < b.x1 && a.x1 > b.x0 && a.y0 < b.y1 && a.y1 > b.y0;
const inBounds = (b: Box) =>
  b.x0 >= m.l - 0.5 && b.x1 <= W - m.r + 0.5 && b.y0 >= m.t - 0.5 && b.y1 <= H - m.b + 0.5;

// reserve the two axis captions so no team label lands on top of them.
// Only needed in quadrant mode (captions sit inside the plot at the cross); in
// scale mode the titles live on the outer edges, clear of every point.
const reserved: Box[] = [];
if (!scale) {
  const w = xLabel.length * CH, cx = W - m.r; // anchored end
  reserved.push({ x0: cx - w, x1: cx, y0: y0 - 1 - LH, y1: y0 - 1 + 0.3 });
  const wy = yLabel.length * CH, cy = x0 + 1.2; // anchored start
  reserved.push({ x0: cy, x1: cy + wy, y0: m.t + 2.5 - LH, y1: m.t + 2.5 + 0.3 });
}

const cands = [
  { dx: 2.2, dy: 0.6, anchor: "start" },
  { dx: -2.2, dy: 0.6, anchor: "end" },
  { dx: 0, dy: -2.0, anchor: "middle" },
  { dx: 0, dy: 3.1, anchor: "middle" },
  { dx: 2.0, dy: -1.6, anchor: "start" },
  { dx: -2.0, dy: -1.6, anchor: "end" },
  { dx: 2.0, dy: 2.7, anchor: "start" },
  { dx: -2.0, dy: 2.7, anchor: "end" },
] as const;

const boxFor = (px: number, py: number, w: number, c: (typeof cands)[number]) => {
  const bx = px + c.dx, by = py + c.dy;
  const x0b = c.anchor === "start" ? bx : c.anchor === "end" ? bx - w : bx - w / 2;
  const x1b = c.anchor === "start" ? bx + w : c.anchor === "end" ? bx : bx + w / 2;
  return { x0: x0b, x1: x1b, y0: by - LH, y1: by + 0.3, bx, by };
};

// place the most important labels first (Spain, then bigger dots) so they win
// the prime right-hand slot and everyone else routes around them
const labeled = points
  .filter((p) => p.show || p.highlight)
  .sort((a, b) => Number(!!b.highlight) - Number(!!a.highlight));

const placed: Box[] = [...reserved];
const labels = labeled.map((p) => {
  const px = sx(p.x), py = sy(p.y);
  const txt = p.tla ?? p.label;
  const w = txt.length * CH;
  let pick = boxFor(px, py, w, cands[0]);
  let cand: (typeof cands)[number] = cands[0];
  for (const c of cands) {
    const b = boxFor(px, py, w, c);
    if (!inBounds(b)) continue;
    if (placed.some((q) => overlaps(b, q))) continue;
    pick = b; cand = c; break;
  }
  placed.push(pick);
  const far = Math.abs(cand.dx) + Math.abs(cand.dy) > 3.2;
  const leadX = cand.anchor === "end" ? pick.x1 : cand.anchor === "start" ? pick.x0 : pick.bx;
  return {
    px, py, txt, anchor: cand.anchor, bx: pick.bx, by: pick.by,
    hi: !!p.highlight, leader: far, leadX, leadY: pick.by - LH * 0.35,
  };
});
const labeledKeys = new Set(labeled.map((p) => p.label));
---

<figure class="scatter">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" preserveAspectRatio="xMidYMid meet"
       aria-label={ariaText}>
    <!-- scale mode: light numeric y-gridlines + tick labels, and edge axes -->
    {scale && yticks.map((v) => (
      <>
        <line x1={m.l} y1={sy(v)} x2={W - m.r} y2={sy(v)} class="grid" />
        <text x={m.l - 1.3} y={sy(v) + 0.6} text-anchor="end" class="tick">{v}</text>
      </>
    ))}
    {scale && <line x1={m.l} y1={m.t} x2={m.l} y2={H - m.b} class="axisln" />}
    {scale && <line x1={m.l} y1={H - m.b} x2={W - m.r} y2={H - m.b} class="axisln" />}
    <!-- reference lines at the average team / plate average -->
    <line x1={x0} y1={m.t} x2={x0} y2={H - m.b} class="ref" />
    <line x1={m.l} y1={y0} x2={W - m.r} y2={y0} class="ref" />
    {scale ? (
      <>
        <text transform={`translate(${m.l - 5.5} ${(m.t + (H - m.b)) / 2}) rotate(-90)`}
              text-anchor="middle" class="axis">{yLabel}</text>
        <text x={(m.l + (W - m.r)) / 2} y={H - 1.3} text-anchor="middle" class="axis">{xLabel}</text>
      </>
    ) : (
      <>
        <text x={W - m.r} y={y0 - 1} class="axis" text-anchor="end">{xLabel}</text>
        <text x={x0 + 1.2} y={m.t + 2.5} class="axis">{yLabel}</text>
      </>
    )}
    <!-- leader lines first, so dots and labels sit on top -->
    {labels.filter((l) => l.leader).map((l) => (
      <line x1={l.px} y1={l.py} x2={l.leadX} y2={l.leadY} class="lead" />
    ))}
    {points.map((p) => (
      <circle cx={sx(p.x)} cy={sy(p.y)}
              r={p.highlight ? 1.9 : labeledKeys.has(p.label) ? 1.15 : 0.9}
              class:list={["dot", { hi: p.highlight, on: labeledKeys.has(p.label) && !p.highlight }]} />
    ))}
    {labels.map((l) => (
      <text x={l.bx} y={l.by} text-anchor={l.anchor} class:list={["lbl", { hi: l.hi }]}>{l.txt}</text>
    ))}
  </svg>
  <figcaption class="scatter__cap mono">{capText}</figcaption>
</figure>

<style>
  .scatter { margin: 0 auto; max-width: var(--measure); }
  .scatter svg { width: 100%; height: auto; display: block; background: var(--paper-raised); border: 1px solid var(--line); }
  .ref { stroke: var(--line-strong); stroke-width: 0.15; stroke-dasharray: 0.6 0.6; }
  .grid { stroke: var(--line); stroke-width: 0.1; }
  .axisln { stroke: var(--line-strong); stroke-width: 0.12; }
  .tick { font-family: var(--mono); font-size: 1.7px; fill: var(--ink-faint); }
  .axis { font-family: var(--mono); font-size: 1.7px; fill: var(--ink-faint); letter-spacing: 0.02em; }
  .dot { fill: var(--ink-faint); opacity: 0.42; }
  .dot.on { fill: var(--ink-soft); opacity: 0.9; }
  .dot.hi { fill: var(--gold); opacity: 1; stroke: var(--ink); stroke-width: 0.25; }
  .lead { stroke: var(--ink-faint); stroke-width: 0.12; opacity: 0.6; }
  .lbl { font-family: var(--mono); font-size: 1.7px; fill: var(--ink-soft); }
  .lbl.hi { fill: var(--ink); font-weight: 700; }
  .scatter__cap { margin-top: 0.55rem; font-size: var(--mono-xs); color: var(--ink-faint); line-height: 1.5; }
</style>
