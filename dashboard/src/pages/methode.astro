---
import Base from "../layouts/Base.astro";
import PipelineDiagram from "../components/PipelineDiagram.astro";
import StarSchema from "../components/StarSchema.astro";
import metadata from "../data/metadata.json";
import { SITE } from "../lib/site";

const layers = [
  {
    tag: "Raw · bronze", title: "On garde tout, intact",
    text: "Chaque nuit, les réponses de l'API sont écrites en Parquet horodaté et versionnées dans Git — sans la moindre transformation. C'est le filet de sécurité : si un calcul a un bug, tout se reconstruit d'ici sans rappeler l'API. L'écriture est idempotente, donc rejouer un run ne crée jamais de doublon.",
  },
  {
    tag: "Staging · silver", title: "On nettoie et on normalise",
    text: "Des vues dbt déplient les structures imbriquées, castent les dates (VARCHAR → TIMESTAMP) et réconcilient les référentiels. Exemple concret : le groupe est écrit « GROUP_A » côté matchs et « Group A » côté classements — un piège à jointures silencieuses, résolu par un group_code canonique unique.",
  },
  {
    tag: "Marts · gold", title: "On modélise pour répondre aux questions",
    text: "Un schéma en étoile (faits + dimensions) prêt pour le dashboard. Le morceau le plus intéressant : fct_group_standings est recalculé depuis les seuls résultats, avec les règles de départage de la FIFA (points, diff, buts, puis confrontations directes).",
  },
];

const figures = [
  { v: "1", u: "run / jour", d: "06:00 UTC, en automatique" },
  { v: `${metadata.dbt_nodes_total}`, u: "nœuds dbt", d: "modèles + tests, verts à chaque build" },
  { v: metadata.reconciliation, u: "réconcilié", d: "calcul vs classement officiel" },
  { v: "0 €", u: "/ mois", d: "APIs, calcul et hébergement gratuits" },
];
---

<Base title="Méthode" description="Comment ce site se fabrique : un pipeline de données automatisé (médaillon raw/staging/marts), une modélisation en étoile et un test de réconciliation de bout en bout.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Méthode · data engineering</p>
      <h1 class="h1 intro__title">Personne ne met ce site à jour.</h1>
      <p class="lede measure intro__lede">
        Ce dashboard est le dernier maillon d'un pipeline ELT qui tourne seul
        chaque matin. Voici comment la donnée voyage de l'API à la page — et
        comment on prouve qu'elle est juste.
      </p>
    </div>
  </section>

  <!-- ARCHITECTURE -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow eyebrow--seq"><span class="seq">/</span> Architecture</p>
      <div class="reveal"><PipelineDiagram /></div>
      <p class="prose measure schema-note">
        Architecture <strong>ELT</strong> en médaillon : on charge d'abord la
        donnée brute, puis on transforme <em>dans</em> la base avec du SQL — des
        transformations rejouables à volonté. DuckDB fait tourner tout ça
        in-process, sans serveur.
      </p>
    </div>
  </section>

  <!-- THE THREE LAYERS -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow eyebrow--seq"><span class="seq">/</span> Les trois couches</p>
      <div class="layers">
        {layers.map((l) => (
          <div class="layer reveal">
            <p class="layer__tag mono">{l.tag}</p>
            <h2 class="layer__title h3">{l.title}</h2>
            <p class="layer__text prose">{l.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- STAR SCHEMA -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow eyebrow--seq"><span class="seq">/</span> Le schéma en étoile</p>
      <h2 class="h2 blk__title">Faits au centre, dimensions autour</h2>
      <p class="prose measure blk__lede">
        Les <strong>tables de faits</strong> (<span class="mono">fct_</span>)
        enregistrent des événements mesurables — un match, un classement ; les
        <strong>dimensions</strong> (<span class="mono">dim_</span>) décrivent
        les entités — une équipe. Les faits pointent vers les dimensions par
        clés étrangères. C'est le modèle dimensionnel classique.
      </p>
      <div class="reveal schema-block"><StarSchema /></div>
    </div>
  </section>

  <!-- RECONCILIATION -->
  <section class="section">
    <div class="wrap recon-wrap">
      <p class="eyebrow eyebrow--seq"><span class="seq">/</span> Tester la donnée</p>
      <h2 class="h2 blk__title">La preuve que les chiffres sont justes</h2>
      <div class="recon__body prose measure">
        <p>
          Chaque build exécute <strong>{metadata.dbt_nodes_total} nœuds</strong>
          — modèles et tests : unicité et non-nullité des clés, intégrité des
          relations faits→dimensions, et des tests de volumétrie qui échouent si
          une jointure perd la moindre ligne.
        </p>
        <p>
          Le test central va plus loin : le classement <em>recalculé</em> depuis
          les résultats est comparé, ligne à ligne, au classement officiel de la
          source — points, différence de buts, buts marqués, position.
        </p>
        <p>
          La moindre divergence fait échouer tout le pipeline. Aujourd'hui, les
          deux coïncident sur <strong class="pitch">{metadata.reconciliation}</strong> équipes.
        </p>
      </div>
    </div>
  </section>

  <!-- FIGURES -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow eyebrow--seq"><span class="seq">/</span> En chiffres</p>
      <div class="figures">
        {figures.map((f) => (
          <div class="fig">
            <div class="fig__v display">{f.v}<span class="fig__u mono">{f.u}</span></div>
            <div class="fig__d mono">{f.d}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- STACK -->
  <section class="section">
    <div class="wrap stack-wrap">
      <p class="eyebrow eyebrow--seq"><span class="seq">/</span> Stack &amp; code</p>
      <ul class="stack mono">
        {SITE.stack.map((t) => <li>{t}</li>)}
      </ul>
      <p class="stack__cta">
        Le code, les tests et l'historique des runs sont publics&nbsp;:
        <a href={SITE.repo} rel="noopener">{SITE.repo.replace("https://", "")}</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .intro__title { margin-top: 1.2rem; }
  .intro__lede { margin-top: 1.2rem; }
  .schema-note { margin-top: 1.5rem; }
  .schema-note em { font-style: italic; }

  .layers { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 3vw, 2.5rem); margin-top: 1.8rem; }
  .layer { border-top: 2px solid var(--ink); padding-top: 1rem; }
  .layer__tag { font-size: var(--mono-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--pitch); }
  .layer__title { margin-top: 0.6rem; }
  .layer__text { margin-top: 0.7rem; font-size: 0.98rem; color: var(--ink-soft); }

  .blk__title { margin-top: 1rem; }
  .blk__lede { margin-top: 1rem; }
  .schema-block { margin-top: 2rem; }

  .recon__body { margin-top: 1.1rem; }
  .recon__body strong { font-weight: 600; }
  .recon__body em { font-style: italic; }

  .figures { margin-top: 1.8rem; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line-strong); }
  .fig { padding: 1.3rem 1rem 1.2rem 0; border-right: 1px solid var(--line); }
  .fig:last-child { border-right: none; }
  .fig__v { font-size: clamp(2.4rem, 5vw, 3.4rem); line-height: 1; font-weight: 380; display: flex; align-items: baseline; gap: 0.4rem; flex-wrap: wrap; }
  .fig__u { font-size: var(--mono-sm); color: var(--ink-faint); font-weight: 400; letter-spacing: 0.04em; }
  .fig__d { margin-top: 0.7rem; font-size: var(--mono-xs); letter-spacing: 0.04em; color: var(--ink-soft); text-transform: uppercase; }

  .stack { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 1.6rem 0 0; padding: 0; list-style: none; }
  .stack li { font-size: var(--mono-sm); padding: 0.35rem 0.7rem; border: 1px solid var(--line-strong); color: var(--ink-soft); }
  .stack__cta { margin-top: 1.6rem; font-size: 1.05rem; }
  .stack__cta a { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--line-strong); }
  .stack__cta a:hover { text-decoration-color: var(--pitch); }

  @media (max-width: 820px) { .layers { grid-template-columns: 1fr; gap: 1.75rem; } }
  @media (max-width: 640px) {
    .figures { grid-template-columns: repeat(2, 1fr); }
    .fig:nth-child(2) { border-right: none; }
    .fig:nth-child(1), .fig:nth-child(2) { border-bottom: 1px solid var(--line); }
  }
</style>
