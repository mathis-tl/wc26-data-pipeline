---
import Base from "../layouts/Base.astro";
import GroupTable from "../components/GroupTable.astro";
import groups from "../data/groups.json";
---

<Base title="Groupes" description="Les douze groupes de la Coupe du Monde 2026, classements recalculés depuis les résultats bruts et réconciliés avec le classement officiel.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Phase de groupes</p>
      <h1 class="h1 intro__title">Les douze groupes</h1>
      <p class="lede measure intro__lede">
        48 équipes, 12 groupes de quatre. Les deux premiers de chaque groupe et
        les huit meilleurs troisièmes rejoignent les 16es de finale.
      </p>

      <div class="recon reveal">
        <p class="recon__label mono">Note de méthode</p>
        <p class="recon__text">
          Ces classements ne sont pas recopiés depuis l'API : ils sont
          <strong>recalculés à partir des seuls résultats des matchs</strong>,
          avec les règles de départage de la FIFA (points, différence de buts,
          buts marqués, puis confrontations directes). Un test automatique les
          confronte chaque jour au classement officiel —
          <strong class="pitch">réconciliés 48/48</strong>.
        </p>
      </div>

      <ul class="legend mono" aria-label="Légende">
        <li><span class="key key--qual" aria-hidden="true"></span>Qualifié (1er–2e)</li>
        <li><span class="key key--third" aria-hidden="true"></span>Meilleur 3e</li>
        <li><span class="key key--out" aria-hidden="true"></span>Éliminé</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid">
        {groups.map((g) => (
          <div class="grid__cell reveal"><GroupTable group={g} /></div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .intro__title { margin-top: 1.2rem; }
  .intro__lede { margin-top: 1.2rem; }

  .recon {
    margin-top: 2.2rem; padding: 1.4rem 1.5rem;
    background: var(--paper-raised); border-left: 3px solid var(--pitch);
    max-width: 46rem;
  }
  .recon__label {
    font-size: var(--mono-xs); letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-faint); margin-bottom: 0.5rem;
  }
  .recon__text { font-size: 1.02rem; line-height: 1.6; }
  .recon__text strong { font-weight: 600; }

  .legend { display: flex; flex-wrap: wrap; gap: 1.4rem; margin-top: 2rem; font-size: var(--mono-sm); color: var(--ink-soft); }
  .legend li { display: flex; align-items: center; gap: 0.5rem; }
  .key { width: 0.85rem; height: 0.85rem; display: inline-block; }
  .key--qual { background: var(--pitch); }
  .key--third { background: repeating-linear-gradient(-45deg, var(--pitch), var(--pitch) 2px, transparent 2px, transparent 4px); border: 1px solid var(--pitch); }
  .key--out { background: var(--paper-sunk); border: 1px solid var(--line-strong); }

  .grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(20.5rem, 1fr));
    gap: clamp(1.75rem, 4vw, 3rem);
  }
  @media (max-width: 480px) {
    .grid { grid-template-columns: 1fr; }
    .recon { padding: 1.2rem 1.15rem; }
  }
</style>
