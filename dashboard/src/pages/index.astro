---
import Base from "../layouts/Base.astro";
import GroupTable from "../components/GroupTable.astro";
import BracketMatch from "../components/BracketMatch.astro";
import PipelineDiagram from "../components/PipelineDiagram.astro";
import StarSchema from "../components/StarSchema.astro";
import BarChart from "../components/BarChart.astro";
import StackedBar from "../components/StackedBar.astro";
import ReconciliationDiagram from "../components/ReconciliationDiagram.astro";
import TopScorers from "../components/TopScorers.astro";

import metrics from "../data/key_metrics.json";
import topScorers from "../data/top_scorers.json";
import groups from "../data/groups.json";
import bracket from "../data/bracket.json";
import goalsByStage from "../data/goals_by_stage.json";
import scorelines from "../data/scorelines.json";
import split from "../data/results_split.json";
import championData from "../data/champion.json";
import metadata from "../data/metadata.json";

const stats = [
  { value: metrics.matches_played, total: metrics.matches_total, label: "matchs joués" },
  { value: metrics.goals_scored, label: "buts inscrits" },
  { value: metrics.teams, label: "équipes" },
  { value: metrics.avg_goals_per_match, label: "buts / match", decimal: true },
];

const champion = championData.champion;

const goalItems = goalsByStage
  .filter((s) => s.goals != null)
  .map((s) => ({ label: s.label, value: s.goals as number }));
const scoreItems = scorelines.map((s) => ({ label: s.scoreline, value: s.count }));
const splitSegs = [
  { label: "Victoire à domicile", value: split.home_wins, tone: "var(--accent)" },
  { label: "Match nul", value: split.draws, tone: "var(--ink-faint)" },
  { label: "Victoire à l'extérieur", value: split.away_wins, tone: "var(--teal)" },
];
---

<Base>
  <!-- HERO -->
  <section class="section hero" id="haut">
    <div class="wrap">
      <p class="eyebrow">États-Unis · Canada · Mexique — 48 équipes</p>
      <h1 class="display hero__title">Le Mondial,<br />recalculé chaque&nbsp;matin.</h1>
      <p class="lede measure hero__lede">
        Un pipeline de données a suivi toute la Coupe du Monde 2026 : chaque
        nuit, il récupérait les résultats, reconstruisait les classements avec
        les règles de la FIFA et les vérifiait face à l'officiel. Voici le
        tournoi, raconté par la machine.
      </p>
    </div>
  </section>

  <!-- CHAMPION -->
  {champion && (
    <section class="champ" aria-label="Champion">
      <div class="champ__media">
        <img class="champ__img" src="/photos/champion.avif" alt="Célébration du titre" loading="lazy" decoding="async" />
        <span class="champ__wash" aria-hidden="true"></span>
        <span class="champ__grain" aria-hidden="true"></span>
      </div>
      <div class="wrap champ__inner">
        <p class="champ__eyebrow mono">Champion du monde · 19 juillet 2026</p>
        <h2 class="champ__name display">{champion.team_name}</h2>
        <p class="champ__final mono">
          Finale · {champion.team_name} {champion.final_score} {champion.runner_up}
        </p>
      </div>
    </section>
  )}

  <!-- KEY NUMBERS -->
  <section class="section">
    <div class="wrap">
      <div class="scoreboard" role="list">
        {stats.map((s) => (
          <div class="stat" role="listitem">
            <div class="stat__value display">
              <span class="mono-num" data-count={String(s.decimal ? s.value.toFixed(2) : s.value)}>{s.decimal ? s.value.toFixed(2) : s.value}</span>{s.total ? <span class="stat__total mono">/{s.total}</span> : null}
            </div>
            <div class="stat__label mono">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- EDITORIAL PHOTO (natural, no filter) -->
  <section class="section band">
    <div class="wrap">
      <figure class="photo">
        <img class="photo__img" src="/photos/wc8.avif" alt="Ferveur des supporters lors de la Coupe du Monde 2026" loading="lazy" decoding="async" />
        <figcaption class="photo__cap mono">États-Unis · Canada · Mexique — l'été 2026</figcaption>
      </figure>
    </div>
  </section>

  <!-- CHARTS -->
  <section class="section" id="chiffres">
    <div class="wrap">
      <p class="eyebrow eyebrow--seq"><span class="seq">/</span> Le tournoi en chiffres</p>
      <h2 class="h2 sec__title">Ce que disent 104 matchs</h2>
      <div class="charts">
        <div class="reveal"><BarChart caption="Buts par phase" unit="buts" items={goalItems} note="La phase de groupes concentre 72 des 104 matchs." /></div>
        <div class="reveal"><BarChart caption="Scores les plus fréquents" unit="matchs" items={scoreItems} accent="var(--teal)" /></div>
        <div class="reveal charts__wide"><StackedBar caption="Issue des matchs (à domicile / nul / à l'extérieur)" segments={splitSegs} /></div>
      </div>
    </div>
  </section>

  <!-- TOP SCORERS -->
  <section class="section" id="buteurs">
    <div class="wrap">
      <div class="section__head">
        <p class="eyebrow eyebrow--seq"><span class="seq">/</span> Meilleurs buteurs</p>
        <span class="scorers__src mono">via l'endpoint /scorers</span>
      </div>
      <h2 class="h2 sec__title">Le classement des buteurs</h2>
      <p class="lede measure sec__lede">
        Une deuxième source du même pipeline : buts, passes décisives et penalties,
        par joueur. <strong>{topScorers[0]?.player_name}</strong> termine soulier d'or.
      </p>
      <div class="reveal"><TopScorers scorers={topScorers} /></div>
    </div>
  </section>

  <!-- IMAGE DIVIDER -->
  <section class="section band">
    <div class="wrap">
      <figure class="duo">
        <div class="duo__frame">
          <img class="duo__img" src="/photos/knockout.avif" alt="Action lors d'un match à élimination directe" loading="lazy" decoding="async" />
          <span class="duo__wash" aria-hidden="true"></span>
          <span class="duo__grain" aria-hidden="true"></span>
        </div>
        <figcaption class="duo__cap mono">Phase finale · Coupe du Monde 2026</figcaption>
      </figure>
    </div>
  </section>

  <!-- GROUPS -->
  <section class="section" id="groupes">
    <div class="wrap">
      <p class="eyebrow eyebrow--seq"><span class="seq">/</span> Phase de groupes</p>
      <h2 class="h2 sec__title">Les douze groupes</h2>
      <div class="groups-aside">
        <div class="recon reveal">
          <p class="recon__label mono">Recalculé, pas recopié</p>
          <p class="recon__text">
            Ces classements sont <strong>reconstruits à partir des seuls résultats
            des matchs</strong>, avec les règles de départage de la FIFA. Un test
            automatique les confronte chaque jour au classement officiel —
            <strong class="pitch">réconciliés 48/48</strong>.
          </p>
        </div>
        <img class="groups-aside__img" src="/photos/groups.avif"
             alt="Supporters lors d'un match de poule de la Coupe du Monde 2026" loading="lazy" decoding="async" />
      </div>
      <ul class="legend mono" aria-label="Légende">
        <li><span class="key key--qual" aria-hidden="true"></span>Qualifié (1er–2e)</li>
        <li><span class="key key--third" aria-hidden="true"></span>Meilleur 3e</li>
        <li><span class="key key--out" aria-hidden="true"></span>Éliminé</li>
      </ul>
      <div class="grid">
        {groups.map((g) => <div class="reveal"><GroupTable group={g} /></div>)}
      </div>
    </div>
  </section>

  <!-- PHOTO BAND (duotone) -->
  <section class="section band">
    <div class="wrap">
      <figure class="duo">
        <div class="duo__frame">
          <img class="duo__img" src="/photos/wc5.avif" alt="Duel lors d'un match de la Coupe du Monde 2026" loading="lazy" decoding="async" />
          <span class="duo__wash" aria-hidden="true"></span>
          <span class="duo__grain" aria-hidden="true"></span>
        </div>
        <figcaption class="duo__cap mono">Le tableau final — 32 équipes, un titre</figcaption>
      </figure>
    </div>
  </section>

  <!-- BRACKET -->
  <section class="section" id="bracket">
    <div class="wrap">
      <p class="eyebrow eyebrow--seq"><span class="seq">/</span> Phase finale</p>
      <h2 class="h2 sec__title">De trente-deux à un</h2>
    </div>
    <div class="wrap bracket-scroll">
      <div class="bracket" role="list">
        {bracket.map((round) => (
          <div class="round" role="listitem">
            <div class="round__head">
              <span class="round__label mono">{round.label}</span>
              <span class="round__count mono">{round.matches.length}</span>
            </div>
            <div class="round__cards">
              {round.matches.map((m) => <BracketMatch match={m} />)}
            </div>
          </div>
        ))}
      </div>
    </div>
    <p class="wrap bracket-hint mono">↔ faites défiler le tableau</p>
  </section>

  <!-- METHOD -->
  <section class="section" id="methode">
    <div class="wrap">
      <p class="eyebrow eyebrow--seq"><span class="seq">/</span> Comment c'est construit</p>
      <h2 class="h2 sec__title">Le pipeline de données</h2>
      <div class="media-aside">
        <p class="lede sec__lede">
          Architecture ELT en médaillon : on garde la donnée brute intacte, puis
          on transforme dans la base avec du SQL — rejouable à volonté, testé à
          chaque étape.
        </p>
        <img class="media-aside__img" src="/photos/opening.avif"
             alt="Ambiance de stade lors de la Coupe du Monde 2026" loading="lazy" decoding="async" />
      </div>
      <div class="reveal method__diagram"><PipelineDiagram /></div>

      <div class="method__cols">
        <div class="method__schema">
          <h3 class="h3 method__h">Le schéma en étoile</h3>
          <p class="prose method__p">
            Des <strong>faits</strong> (<span class="mono">fct_</span>) au centre
            — matchs, classements — reliés aux <strong>dimensions</strong>
            (<span class="mono">dim_</span>) par clés étrangères. Le modèle
            dimensionnel classique.
          </p>
          <div class="reveal"><StarSchema /></div>
        </div>
      </div>

      <div class="method__test">
        <h3 class="h3 method__h">La preuve que les chiffres sont justes</h3>
        <div class="method__test-grid">
          <div class="reveal"><ReconciliationDiagram /></div>
          <div class="prose method__test-text">
            <p>
              Chaque build exécute <strong>{metadata.dbt_nodes_total} nœuds</strong>
              — modèles et tests : clés uniques et non nulles, intégrité des
              relations, et volumétrie qui échoue si une jointure perd une ligne.
            </p>
            <p>
              Le test central, lui, confronte deux classements construits
              séparément. S'ils divergent d'une seule ligne, tout le pipeline
              s'arrête.
            </p>
          </div>
        </div>
      </div>

      <ul class="stack mono">
        <li>Python</li><li>httpx</li><li>DuckDB</li><li>dbt</li>
        <li>Astro</li><li>GitHub Actions</li><li>Vercel</li>
      </ul>
      <p class="stack__cta">
        Le code, les tests et l'historique des runs sont publics&nbsp;:
        <a href="https://github.com/mathis-tl/wc26-data-pipeline" rel="noopener">github.com/mathis-tl/wc26-data-pipeline</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: clamp(2.5rem, 6vw, 4.5rem); padding-bottom: clamp(2rem, 5vw, 3.5rem); }
  .hero__title { margin-top: 1.4rem; font-size: var(--h1); }
  .hero__lede { margin-top: 1.5rem; }

  /* champion band */
  .champ { position: relative; isolation: isolate; }
  .champ__media { position: absolute; inset: 0; overflow: hidden; z-index: -1; background: var(--ink); }
  .champ__img { width: 100%; height: 100%; object-fit: cover; object-position: center 28%; filter: grayscale(0.55) contrast(1.05) brightness(1.12); opacity: 0.92; }
  /* horizontal wash: dark behind the (left-aligned) gold text, the photo opens up on the right */
  .champ__wash { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(22,20,15,0.9) 0%, rgba(22,20,15,0.62) 42%, rgba(22,20,15,0.28) 100%); }
  .champ__grain { position: absolute; inset: 0; background-image: radial-gradient(rgba(238,243,234,0.06) 0.5px, transparent 0.6px); background-size: 3px 3px; }
  .champ__inner { padding-block: clamp(3rem, 10vw, 6.5rem); color: var(--paper-on-accent); }
  .champ__eyebrow { font-size: var(--mono-sm); letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold-bright); }
  .champ__name { font-size: clamp(3.5rem, 12vw, 8rem); line-height: 0.95; margin-top: 0.5rem; color: var(--gold-bright); letter-spacing: -0.03em; }
  .champ__final { margin-top: 1rem; font-size: var(--mono-sm); color: rgba(246,239,230,0.85); letter-spacing: 0.02em; }

  /* scoreboard */
  .scoreboard { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line-strong); }
  .stat { padding: 1.4rem 1rem 1.2rem 0; border-right: 1px solid var(--line); }
  .stat:last-child { border-right: none; }
  .stat__value { font-size: var(--giant); line-height: 0.92; letter-spacing: -0.04em; font-weight: 800; display: flex; align-items: baseline; gap: 0.15em; }
  .mono-num { font-family: var(--sans); font-variant-numeric: lining-nums tabular-nums; }
  .stat__total { font-size: 0.32em; color: var(--ink-faint); font-weight: 400; align-self: flex-end; margin-bottom: 0.6em; }
  .stat__label { margin-top: 0.7rem; font-size: var(--mono-sm); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); }

  .sec__title { margin-top: 1rem; }
  .sec__lede { margin-top: 1.1rem; }
  .sec__lede strong { color: var(--ink); font-weight: 600; }
  .section__head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .scorers__src { font-size: var(--mono-xs); color: var(--ink-faint); letter-spacing: 0.04em; }

  /* charts */
  .charts { margin-top: 2rem; display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(2rem, 5vw, 3.5rem) clamp(2rem, 5vw, 4rem); }
  .charts__wide { grid-column: 1 / -1; max-width: 42rem; }

  /* image band (duotone) */
  .band { padding-block: clamp(2.5rem, 6vw, 4rem); }
  .photo { margin: 0; }
  .photo__img { width: 100%; max-height: 30rem; object-fit: cover; border: 1px solid var(--line); }
  .photo__cap { margin-top: 0.55rem; font-size: var(--mono-xs); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-faint); }
  .groups-aside { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; margin-top: 1.6rem; }
  .groups-aside__img { width: 100%; height: 100%; max-height: 18rem; object-fit: cover; border: 1px solid var(--line); }
  @media (max-width: 720px) { .groups-aside { grid-template-columns: 1fr; } .groups-aside__img { max-height: 14rem; order: -1; } }
  .duo__frame { position: relative; overflow: hidden; height: clamp(14rem, 32vw, 24rem); background: var(--ink); isolation: isolate; }
  .duo__img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.12) brightness(1.06); mix-blend-mode: multiply; }
  .duo__wash { position: absolute; inset: 0; z-index: 1; background: var(--paper); mix-blend-mode: screen; opacity: 0.3; }
  .duo__grain { position: absolute; inset: 0; z-index: 2; background-image: radial-gradient(rgba(22,20,15,0.5) 0.5px, transparent 0.6px); background-size: 3px 3px; opacity: 0.16; mix-blend-mode: multiply; }
  .duo__cap { margin-top: 0.55rem; font-size: var(--mono-xs); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-faint); }

  /* groups */
  .recon { margin-top: 1.6rem; padding: 1.4rem 1.5rem; background: var(--paper-raised); border-left: 3px solid var(--accent); max-width: 46rem; }
  .recon__label { font-size: var(--mono-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: 0.5rem; }
  .recon__text { font-size: 1.02rem; line-height: 1.6; }
  .recon__text strong { font-weight: 600; }
  .legend { display: flex; flex-wrap: wrap; gap: 1.4rem; margin-top: 1.6rem; font-size: var(--mono-sm); color: var(--ink-soft); }
  .legend li { display: flex; align-items: center; gap: 0.5rem; }
  .key { width: 0.85rem; height: 0.85rem; display: inline-block; }
  .key--qual { background: var(--accent); }
  .key--third { background: repeating-linear-gradient(-45deg, var(--accent), var(--accent) 2px, transparent 2px, transparent 4px); border: 1px solid var(--accent); }
  .key--out { background: var(--paper-sunk); border: 1px solid var(--line-strong); }
  .grid { margin-top: 2rem; display: grid; grid-template-columns: repeat(auto-fill, minmax(20.5rem, 1fr)); gap: clamp(1.75rem, 4vw, 3rem); }

  /* bracket */
  .bracket-scroll { margin-top: 1.6rem; }
  /* vertical bracket: rounds stack top-to-bottom, matches flow in a grid per round */
  .bracket { display: flex; flex-direction: column; gap: clamp(1.75rem, 4vw, 2.75rem); }
  .round { width: 100%; }
  .round__head { display: flex; align-items: baseline; justify-content: space-between; padding-bottom: 0.6rem; margin-bottom: 0.9rem; border-bottom: 2px solid var(--ink); }
  .round__label { font-size: var(--mono-sm); letter-spacing: 0.08em; text-transform: uppercase; }
  .round__count { font-size: var(--mono-sm); color: var(--ink-faint); }
  .round__cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(14.5rem, 1fr)); gap: 0.75rem; }
  .bracket-hint { display: none; }

  /* method */
  .method__diagram { margin-top: 2rem; }
  .method__cols { margin-top: var(--section-gap); }

  /* natural image beside a paragraph (no duotone filter) */
  .media-aside { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; margin-top: 1.2rem; }
  .media-aside__img { width: 100%; height: 100%; max-height: 20rem; object-fit: cover; border: 1px solid var(--line); }

  .method__test-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: start; margin-top: 1.4rem; }
  .method__test-text { align-self: center; }
  .method__h { margin-bottom: 0.8rem; }
  .method__p { max-width: 42rem; margin-bottom: 1.6rem; }
  .method__p strong { font-weight: 600; }
  .method__test { margin-top: var(--section-gap); }
  .method__test .prose strong { font-weight: 600; }
  .stack { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: var(--section-gap) 0 0; padding: 0; list-style: none; }
  .stack li { font-size: var(--mono-sm); padding: 0.35rem 0.7rem; border: 1px solid var(--line-strong); color: var(--ink-soft); }
  .stack__cta { margin-top: 1.6rem; font-size: 1.05rem; }
  .stack__cta a { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--line-strong); }
  .stack__cta a:hover { text-decoration-color: var(--accent); }

  @media (max-width: 820px) {
    .charts { grid-template-columns: 1fr; }
    .media-aside { grid-template-columns: 1fr; }
    .media-aside__img { max-height: 15rem; order: -1; }
    .method__test-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .bracket { flex-direction: column; overflow-x: visible; gap: 2.25rem; }
    .round { flex: 1 1 auto; min-width: 0; width: 100%; }
    .round__cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 0.75rem; }
    .bracket-hint { display: none; }
  }
  @media (max-width: 720px) {
    .scoreboard { grid-template-columns: repeat(2, 1fr); }
    .stat:nth-child(2) { border-right: none; }
    .stat:nth-child(1), .stat:nth-child(2) { border-bottom: 1px solid var(--line); }
    .grid { grid-template-columns: 1fr; }
  }
</style>
