---
import Base from "../layouts/Base.astro";
import GroupTable from "../components/GroupTable.astro";
import BracketMatch from "../components/BracketMatch.astro";
import PipelineDiagram from "../components/PipelineDiagram.astro";
import StarSchema from "../components/StarSchema.astro";
import BarChart from "../components/BarChart.astro";
import StackedBar from "../components/StackedBar.astro";
import ReconciliationDiagram from "../components/ReconciliationDiagram.astro";
import TopScorers from "../components/TopScorers.astro";
import ScatterPlot from "../components/ScatterPlot.astro";
import ProgressionHeatmap from "../components/ProgressionHeatmap.astro";
import Dumbbell from "../components/Dumbbell.astro";
import SpainPath from "../components/SpainPath.astro";
import Shotmap from "../components/Shotmap.astro";
import XgCurve from "../components/XgCurve.astro";
import EditionTimeline from "../components/EditionTimeline.astro";
import Crest from "../components/Crest.astro";
import Term from "../components/Term.astro";
import Takeaway from "../components/Takeaway.astro";
import SourceMatch from "../components/SourceMatch.astro";

import metrics from "../data/key_metrics.json";
import spainReal from "../data/spain_real.json";
import spainFinalShots from "../data/spain_final_shots.json";
import topScorers from "../data/top_scorers.json";
import spainCase from "../data/spain_case.json";
import teamStrength from "../data/team_strength.json";
import teamReality from "../data/team_reality.json";
import titleOdds from "../data/title_odds.json";
import titleProgression from "../data/title_progression.json";
import spainPath from "../data/spain_path.json";
import modelMeta from "../data/model_meta.json";
import groups from "../data/groups.json";
import bracket from "../data/bracket.json";
import goalsByStage from "../data/goals_by_stage.json";
import scorelines from "../data/scorelines.json";
import editionComparison from "../data/edition_comparison.json";
import upsets from "../data/upsets.json";
import split from "../data/results_split.json";
import championData from "../data/champion.json";
import metadata from "../data/metadata.json";

const stats = [
  { value: metrics.matches_played, total: metrics.matches_total, label: "matchs joués" },
  { value: metrics.goals_scored, label: "buts inscrits" },
  { value: metrics.teams, label: "équipes" },
  { value: metrics.avg_goals_per_match, label: "buts / match", decimal: true },
];

const champion = championData.champion;

const goalItems = goalsByStage
  .filter((s) => s.goals != null)
  .map((s) => ({ label: s.label, value: s.goals as number }));
const scoreItems = scorelines.map((s) => ({ label: s.scoreline, value: s.count }));
const splitSegs = [
  { label: "Victoire à domicile", value: split.home_wins, tone: "var(--accent)" },
  { label: "Match nul", value: split.draws, tone: "var(--ink-faint)" },
  { label: "Victoire à l'extérieur", value: split.away_wins, tone: "var(--teal)" },
];

// --- 2026 in historical context ---
const editions = editionComparison.editions;
const curEd = editions.find((e) => e.is_current)!;
// the most recent edition before 2026 that outscored it → "highest since …"
const higherBefore = editions
  .filter((e) => !e.is_current && e.goals_per_match > curEd.goals_per_match)
  .map((e) => e.year);
const highestSince = higherBefore.length ? Math.max(...higherBefore) : null;

// --- derived KPI context (real, from mart_edition_comparison — never hardcoded) ---
const prevEd = [...editions].filter((e) => !e.is_current).sort((a, b) => b.year - a.year)[0];
const matchesDelta = curEd.matches - prevEd.matches;
const goalsRecord = curEd.goals > Math.max(...editions.filter((e) => !e.is_current).map((e) => e.goals));
const first48 = !editions.some((e) => !e.is_current && e.teams >= 48);
const kpiContext = [
  `+${matchesDelta} vs ${prevEd.year}`,
  goalsRecord ? "record absolu de buts" : `${curEd.goals} au total`,
  first48 ? "1ʳᵉ édition à 48" : `${curEd.teams} équipes`,
  highestSince ? `plus haut depuis ${highestSince}` : "moyenne record",
];

// --- conclusion: tournament records & Spain's place in history, all from marts ---
const goldenBoot = topScorers[0];
const championOnPodium = topScorers.slice(0, 3).some((s) => s.team_name === champion.team_name);
const biggestUpset = upsets[0]; // upsets are ranked by ascending prior win probability
const brazilUpset = upsets.find((u) => u.loser_name === "Brazil");
// the marquee giant-killing (biggest name to fall), else the model's longest shot
const marqueeUpset = brazilUpset ?? biggestUpset;
const spainTitleYears = editions
  .filter((e) => e.winner === "Spain")
  .map((e) => e.year)
  .sort((a, b) => a - b);
const spainPrevTitle = spainTitleYears.filter((y) => y !== curEd.year).at(-1) ?? null;
const spainTitleCount = spainTitleYears.length;

// --- "Did Spain deserve it?" analysis ---
const pct = (p: number) => Math.round(p * 100);
const worstDefRank = Math.max(...teamStrength.map((t) => t.rank_defense));
const scatterPts = teamStrength.map((t) => ({
  x: t.attack, y: t.defense, label: t.team_name, tla: t.team_tla,
  highlight: t.team_name === "Spain",
  // label the top 5, plus the two named outliers: best attack + worst defense
  show: t.rank_overall <= 5 || t.rank_attack === 1 || t.rank_defense === worstDefRank,
}));
// --- reality check (FBref, 48 teams): does the model's defense hold up
// against a real, continuous keeper metric? save% (shots saved / shots on
// target faced) — no xG here, FBref has none for 2026 — chosen over clean
// sheets specifically because cs only takes 5 distinct values across 48
// teams (heavy ties → label collisions on the scatter); save% has 41.
const savePctMean = teamReality.reduce((s, t) => s + t.save_pct, 0) / teamReality.length;
const pearsonR = (() => {
  const xs = teamReality.map((t) => t.defense), ys = teamReality.map((t) => t.save_pct);
  const mx = xs.reduce((a, b) => a + b, 0) / xs.length;
  const my = ys.reduce((a, b) => a + b, 0) / ys.length;
  const cov = xs.reduce((s, x, i) => s + (x - mx) * (ys[i] - my), 0);
  const sx = Math.sqrt(xs.reduce((s, x) => s + (x - mx) ** 2, 0));
  const sy = Math.sqrt(ys.reduce((s, y) => s + (y - my) ** 2, 0));
  return cov / (sx * sy);
})();
const realityPts = teamReality.map((t) => ({
  x: t.defense, y: t.save_pct, label: t.team_name, tla: t.team_tla,
  highlight: t.team_name === "Spain",
  show: t.rank_defense <= 5,
}));
const spainReality = teamReality.find((t) => t.team_name === "Spain")!;
const spainHasTopSavePct = teamReality.every((t) => t.save_pct <= spainReality.save_pct);
const xgCurvePts = spainReal.map((r) => ({ label: r.opponent, real: r.xg_for, model: r.model_xg_for }));

const oddsItems = titleOdds.slice(0, 8).map((t) => ({
  label: t.team_tla ?? t.team_name, value: pct(t.title_prob), display: `${pct(t.title_prob)} %`,
}));
// runner-up, computed rather than named — the ranking shifts whenever the
// model is refit, and a hardcoded second name silently goes stale.
const runnerUp = titleOdds[1];
const runnerUpRatio = Math.round(spainCase.title_prob / runnerUp.title_prob);
// Spain's closest match by the model's own win probability — found, not
// assumed, so the "seul 50/50" claim can't drift out of sync with a refit.
const closestSpainMatch = [...spainPath].sort((a, b) => a.win_prob - b.win_prob)[0];
const rankBadges = [
  { v: `#${spainCase.rank_overall}`, l: "force globale" },
  { v: `#${spainCase.rank_defense}`, l: "défense" },
  { v: `#${spainCase.rank_attack}`, l: "attaque" },
  { v: `${pct(spainCase.title_prob)} %`, l: "probabilité de titre" },
];
// dumbbell: the biggest luck stories among the stronger teams
const dumbbellItems = [...teamStrength]
  .filter((t) => t.played >= 3)
  .sort((a, b) => Math.abs(b.points - b.xpoints) - Math.abs(a.points - a.xpoints))
  .slice(0, 10)
  .sort((a, b) => (b.points - b.xpoints) - (a.points - a.xpoints))
  .map((t) => ({ label: t.team_name, tla: t.team_tla, actual: t.points, expected: t.xpoints }));
// Spain's own rank on that same positive-gap scale — computed, not asserted,
// so the "chance" paragraph applies the same yardstick to Spain as to every
// other team it names (no double standard between "skill" and "luck").
const performanceRank = [...teamStrength]
  .filter((t) => t.played >= 3)
  .sort((a, b) => (b.points - b.xpoints) - (a.points - a.xpoints))
  .findIndex((t) => t.team_name === "Spain") + 1;
// the model's actual strength values — the top of the table, Spain's lead made concrete
const ratingRows = teamStrength.slice(0, 8).map((t) => ({
  rank: t.rank_overall, name: t.team_name, tla: t.team_tla, crest: t.crest,
  rating: t.rating, attack: t.attack, defense: t.defense,
  rankAttack: t.rank_attack, rankDefense: t.rank_defense,
  current: t.team_name === "Spain",
}));
const ratingMax = Math.max(...ratingRows.map((r) => r.rating));
---

<Base>
  <!-- HERO -->
  <section class="section hero" id="haut">
    <div class="wrap">
      <p class="eyebrow"><span class="seq">/</span> États-Unis · Canada · Mexique (48 équipes)</p>
      <h1 class="display hero__title">Le Mondial,<br />recalculé chaque&nbsp;matin.</h1>
      <p class="lede measure hero__lede">
        Un pipeline de données a suivi toute la Coupe du Monde 2026 : chaque
        nuit, il récupérait les résultats, reconstruisait les classements avec
        les règles de la FIFA et les vérifiait face à l'officiel. Voici le
        tournoi, raconté par la machine.
      </p>
    </div>
  </section>

  <!-- CHAMPION -->
  {champion && (
    <section class="champ" aria-label="Champion">
      <div class="champ__media">
        <img class="champ__img" src="/photos/champion.avif" alt="Célébration du titre" loading="lazy" decoding="async" />
        <span class="champ__wash" aria-hidden="true"></span>
        <span class="champ__grain" aria-hidden="true"></span>
      </div>
      <div class="wrap champ__inner">
        <p class="champ__eyebrow mono">Champion du monde · 19 juillet 2026</p>
        <h2 class="champ__name display">{champion.team_name}</h2>
        <p class="champ__final mono">
          Finale · {champion.team_name} {champion.final_score} {champion.runner_up}
        </p>
      </div>
    </section>
  )}

  <!-- KEY NUMBERS -->
  <section class="section">
    <div class="wrap">
      <div class="scoreboard" role="list">
        {stats.map((s, i) => (
          <div class="stat" role="listitem">
            <div class="stat__value display">
              <span class="mono-num" data-count={String(s.decimal ? s.value.toFixed(2) : s.value)}>{s.decimal ? s.value.toFixed(2) : s.value}</span>{s.total ? <span class="stat__total mono">/{s.total}</span> : null}
            </div>
            <div class="stat__label mono">{s.label}</div>
            <div class="stat__ctx mono">{kpiContext[i]}</div>
          </div>
        ))}
      </div>
      <p class="scoreboard__foot mono">
        Chaque repère est calculé depuis <a href="#chiffres">l'historique complet des Coupes du monde</a>,
        1930–2026, jamais saisi à la main.
      </p>
    </div>
  </section>

  <!-- ANALYSIS — the flagship: did Spain deserve it? -->
  <section class="section" id="analyse">
    <div class="wrap">
      <p class="eyebrow"><span class="seq">/</span> Analyse · le verdict de la donnée</p>
      <h2 class="h1 analyse__title">L'Espagne méritait-elle son titre&nbsp;?</h2>
      <div class="prose measure analyse__lede">
        <p>
          L'Espagne a soulevé le trophée le 19 juillet 2026. Mais soulever un
          trophée et <em>être</em> la meilleure équipe du tournoi, ce n'est pas
          tout à fait la même chose&nbsp;: un Mondial se joue en huit matchs, à
          quelques ballons près, et l'histoire du football regorge de champions
          que personne n'annonçait. La Grèce 2004, portée par un bloc défensif et
          un tableau clément. Le Danemark 1992, repêché in extremis et couronné
          trois semaines plus tard. Des équipes qui ont gagné sans avoir été,
          sur l'ensemble de la compétition, nécessairement les meilleures. Alors,
          pour l'Espagne 2026&nbsp;: la donnée peut-elle trancher la question&nbsp;?
        </p>
        <p>
          Un obstacle se pose d'emblée. Notre source principale, football-data.org,
          ne livre que des scores&nbsp;: la date, les deux équipes, le résultat
          final. Ni possession, ni tirs, ni xG, rien qui permette de distinguer une
          équipe qui a dominé et gagné d'une équipe qui a survécu et gagné quand
          même. On a donc répondu en <strong>trois temps</strong>, à trois échelles
          différentes. Pour <strong>les 48 équipes</strong> du tournoi, on estime
          la <strong>force réelle</strong> de chacune à partir des 104 résultats
          disponibles, à l'aide d'un modèle statistique&nbsp;: sa capacité à
          marquer, sa capacité à ne pas encaisser, le tout <strong>corrigé de la
          qualité des adversaires</strong> rencontrés, parce que battre le Brésil
          et battre le dernier du groupe ne peuvent pas peser pareil dans une
          évaluation sérieuse. C'est la matière de cette première partie de la
          page. On confronte ensuite ce modèle à un premier jeu de données
          réelles, mais toujours sur <strong>les 48 équipes</strong>&nbsp;: tirs,
          tirs cadrés et clean sheets réellement enregistrés, via une deuxième
          source (FBref), sans xG&nbsp;: une compétition internationale 2026 n'en
          publie pas. Puis, pour <strong>l'Espagne</strong> spécifiquement, on est
          allé chercher les données les plus fines, match par match&nbsp;:
          possession, tirs, et cette fois du <em>vrai</em> xG, via une troisième
          source (SofaScore), réconciliée avec la première malgré l'absence
          d'identifiants communs entre elles deux.
        </p>
        <p>
          Le modèle porte l'analyse sur tout le plateau, les 48 équipes&nbsp;: c'est
          lui qui situe l'Espagne parmi les autres. FBref élargit un premier
          contrôle réel à ces mêmes 48 équipes, mais reste muet sur le xG. Les
          données SofaScore, elles, ne sont récupérées que pour l'Espagne (le
          quota gratuit ne couvre pas les 104 matchs du tournoi), et vont plus
          loin&nbsp;: c'est le contrôle le plus fin, jusqu'au xG mesuré tir par
          tir. Là où les trois se recoupent, sur le cas espagnol, elles disent la
          même chose, et c'est justement cet accord qui donne confiance dans ce
          que le modèle raconte du reste du tournoi.
        </p>
      </div>

      <div class="howto reveal">
        <p class="howto__label mono">Comment lire ce rapport</p>
        <dl class="howto__grid">
          <div class="howto__item">
            <dt>Note de force</dt>
            <dd><b>0 = une équipe moyenne.</b> Plus le nombre est haut, plus l'équipe est forte&nbsp;: c'est l'attaque et la défense additionnées sur l'échelle du modèle.</dd>
          </div>
          <div class="howto__item">
            <dt>Attaque · Défense</dt>
            <dd>Deux forces distinctes. Pour les <b>deux</b>, plus la valeur est haute, meilleure l'équipe&nbsp;: une défense à 2,48 est la <b>meilleure</b> du tournoi, pas la plus fragile.</dd>
          </div>
          <div class="howto__item">
            <dt>Points attendus (xPts)</dt>
            <dd>Les points qu'une équipe aurait « mérités » vu son niveau de jeu. L'écart avec les points réels mesure la <b>part de chance</b>.</dd>
          </div>
          <div class="howto__item">
            <dt>xG modèle · xG réel</dt>
            <dd>Buts attendus <b>déduits des scores</b> (modèle, 48 équipes) ou <b>mesurés</b> tir par tir (SofaScore, Espagne seule).</dd>
          </div>
        </dl>
      </div>

      <div class="rankrow">
        {rankBadges.map((b) => (
          <div class="rankbadge">
            <div class="rankbadge__v display">{b.v}</div>
            <div class="rankbadge__l mono">{b.l}</div>
          </div>
        ))}
      </div>

      <div class="media-aside media-aside--flow analyse__aside reveal">
        <figure class="analyse__aside-fig">
          <img class="media-aside__img" src="/photos/archive-2002.avif"
               alt="Célébration d'un sacre mondial, archive 2002" loading="lazy" decoding="async" />
          <figcaption class="photo__cap mono">Illustration · liesse d'un sacre mondial, Brésil 2002</figcaption>
        </figure>
        <div class="prose">
          <p>
          Cette liesse-là, celle d'un sacre mondial, se ressemble d'une édition à
          l'autre&nbsp;: les mêmes visages qui se cherchent, le même trophée qui
          circule de bras en bras. Ce qui change, en revanche, c'est ce qu'il y a
          dessous. Parfois une équipe supérieure de bout en bout, qui a dominé
          chacun de ses adversaires. Parfois un concours de circonstances heureux,
          un tableau clément, une semaine de grâce. La suite de cette page tente de
          trancher, chiffre par chiffre, dans lequel des deux camps se range
          l'Espagne 2026.
          </p>
        </div>
      </div>

      <div class="analyse__block reveal">
        <h3 class="h3 analyse__h">La meilleure défense, et de loin</h3>
        <div class="prose measure analyse__p">
          <p>
            Le premier réflexe, pour juger une équipe, est de séparer ce qu'elle
            fait devant de ce qu'elle fait derrière&nbsp;: deux métiers différents,
            deux formes de solidité qui ne vont pas nécessairement de pair la même
            saison. Le modèle sépare nativement les deux, puisqu'il ajuste une
            force d'attaque et une force de défense indépendantes pour chacune des
            48 équipes (le détail du calcul, la formule et le code, sont développés
            plus bas dans la section méthode). On peut alors placer chaque équipe
            sur un plan à deux dimensions&nbsp;: plus on est à droite, plus
            l'attaque est dangereuse&nbsp;; plus on est haut, plus la défense est
            hermétique. Le coin en haut à droite, celui où les deux qualités se
            cumulent, est le plus rare du tournoi&nbsp;: c'est celui des équipes
            complètes, et ce sont généralement elles qui vont loin.
          </p>
          <p>
            C'est précisément dans ce coin que se trouve l'Espagne. Elle possède
            <strong>la défense la plus hermétique du tournoi</strong>&nbsp;: un
            seul but encaissé en huit matchs, un total presque irréel quand on sait
            que le modèle, sur la seule base de la qualité des adversaires
            affrontés, en attendait déjà {spainCase.xga}. Un tel écart, plus de
            deux buts sur l'ensemble du parcours, ne s'explique plus par la chance
            à ce stade&nbsp;: c'est un vrai signal de niveau défensif. Son attaque,
            elle, n'a rien d'anecdotique non plus&nbsp;: elle se classe
            {` #${spainCase.rank_attack}`} sur 48. La nuance honnête, celle que la
            donnée impose et qu'il serait malhonnête de gommer, est que sur ce seul
            critère offensif l'Angleterre a fait mieux, avec la meilleure attaque
            du tournoi. L'Espagne n'était donc pas la meilleure équipe sur chaque
            dimension prise isolément&nbsp;; elle était la plus <em>complète</em>,
            celle qui cumulait deux qualités là où d'autres n'en affichaient
            qu'une seule.
          </p>
        </div>
        <p class="figlabel mono">Fig. 1 · Force d'attaque × force de défense (48 équipes)</p>
        <ScatterPlot points={scatterPts} />

        <p class="prose measure analyse__p analyse__p--after">
          Le graphique donne les positions&nbsp;; voici les valeurs. La
          <strong><Term def="0 = une équipe moyenne. Plus le nombre est haut, plus l'équipe est forte : c'est l'attaque et la défense additionnées sur l'échelle du modèle.">note de force</Term></strong> ci-dessous additionne l'attaque et la
          défense d'une équipe sur l'échelle du modèle (0 = équipe moyenne).
          L'écart est frappant&nbsp;: l'Espagne y pèse <strong>{ratingRows[0].rating.toFixed(2)}</strong>,
          soit plus du double de son dauphin, un gouffre que le reste du plateau
          ne connaît nulle part ailleurs.
        </p>
        <p class="figlabel mono">Note de force du modèle, le haut du classement</p>
        <div class="ratetab mono">
          <div class="ratetab__row ratetab__head">
            <span>#</span><span>Équipe</span><span>Att.</span><span>Déf.</span><span class="ratetab__val">Note</span>
          </div>
          {ratingRows.map((r) => (
            <div class:list={["ratetab__row", { hi: r.current }]}>
              <span class="ratetab__rank">{r.rank}</span>
              <span class="ratetab__team"><Crest url={r.crest} tla={r.tla} size={16} />{r.tla ?? r.name}</span>
              <span class="ratetab__num">{r.attack.toFixed(2)}<sup class="ratetab__rk">#{r.rankAttack}</sup></span>
              <span class="ratetab__num">{r.defense.toFixed(2)}<sup class="ratetab__rk">#{r.rankDefense}</sup></span>
              <span class="ratetab__val">
                <span class="ratetab__bar" style={`width:${Math.round((r.rating / ratingMax) * 100)}%`} aria-hidden="true"></span>
                <b>{r.rating.toFixed(2)}</b>
              </span>
            </div>
          ))}
        </div>
        <p class="ratetab__legend mono">
          Att. et Déf. : plus la valeur est haute, meilleure l'équipe ; le <sup>#</sup> donne
          son rang sur 48. Ainsi l'Espagne a « seulement » la 6ᵉ attaque mais la
          1ʳᵉ défense&nbsp;: c'est ce cumul qui lui donne la meilleure note globale, pas
          un secteur pris isolément.
        </p>
      </div>

      <div class="analyse__block reveal">
        <h3 class="h3 analyse__h">Chance, ou niveau&nbsp;?</h3>
        <div class="media-aside media-aside--flow">
          <figure class="analyse__aside-fig">
            <img class="media-aside__img" src="/photos/england.avif"
                 alt="Célébration anglaise lors de la Coupe du Monde 2026" loading="lazy" decoding="async" />
            <figcaption class="photo__cap mono">Angleterre, l'une des équipes qui a dépassé son niveau attendu</figcaption>
          </figure>
          <div class="prose analyse__p">
            <p>
              Gagner beaucoup peut masquer une part de réussite. Une équipe qui
              empoche des victoires 1-0 sur des scénarios serrés n'est pas
              nécessairement meilleure qu'une équipe qui domine largement mais bute
              sur un gardien inspiré. Pour débusquer cette réussite et la distinguer
              du niveau réel, on compare les points <em>réels</em> de chaque équipe
              à ceux que son niveau de jeu promettait&nbsp;: les <strong><Term def="Les points qu'une équipe aurait « mérités » vu son niveau de jeu, dérivés des probabilités de chacun de ses matchs. L'écart avec les points réels mesure la chance.">points
              attendus</Term></strong>, dérivés directement des probabilités calculées pour
              chacun de ses matchs. L'écart entre les deux, c'est la part de chance,
              dans un sens comme dans l'autre.
            </p>
            <p>
              L'Espagne a pris <strong>{spainCase.points} points</strong> pour
              <strong>{spainCase.xpoints} attendus</strong> ({`+${spainCase.performance}`}).
              Un surplus réel, auquel il faut appliquer la même règle qu'aux
              autres équipes de ce graphique&nbsp;: c'est le {`${performanceRank}`}ᵉ
              plus gros écart positif du tournoi, dans la même fourchette que la
              Suisse ou le Paraguay, loin devant zéro. La part de réussite n'est
              donc pas nulle. Ce qui distingue l'Espagne, ce n'est pas l'absence de
              chance&nbsp;: c'est qu'elle tenait par ailleurs la meilleure défense
              du tournoi et la première place du classement du modèle, une base que
              la réussite est venue amplifier plutôt que remplacer. Le graphique
              ci-dessous replace ce chiffre dans son contexte, parmi les dix écarts
              les plus marqués du tournoi&nbsp;: l'Argentine et l'Angleterre l'ont
              nettement dépassée sur ce même critère&nbsp;; à l'autre bout, le
              Sénégal ou le Japon ont au contraire été trahis par leur classement
              final malgré un profil plus solide que leurs résultats seuls ne le
              laissent penser.
            </p>
          </div>
        </div>
        <div class="xtable mono">
          <div class="xtable__row xtable__head"><span>Espagne</span><span>réel</span><span>attendu</span></div>
          <div class="xtable__row"><span>Points</span><span class="b">{spainCase.points}</span><span>{spainCase.xpoints}</span></div>
          <div class="xtable__row"><span>Buts marqués</span><span class="b">{spainCase.goals_for}</span><span>{spainCase.xgf}</span></div>
          <div class="xtable__row"><span>Buts encaissés</span><span class="b">{spainCase.goals_against}</span><span>{spainCase.xga}</span></div>
        </div>
        <p class="figlabel mono">Fig. 2 · Points réels vs attendus, l'écart mesure la réussite</p>
        <div class="analyse__chart"><Dumbbell items={dumbbellItems} /></div>
      </div>

      <div class="media-aside analyse__aside reveal">
        <p class="prose">
          Un match isolé peut toujours mentir&nbsp;: un poteau, un arbitrage, une
          occasion manquée à la 89ᵉ minute, et le résultat raconte une tout autre
          histoire que le contenu réel du jeu. C'est pour cette raison qu'aucune
          des figures de cette page ne s'appuie sur un seul match&nbsp;: chacune
          agrège l'ensemble d'un parcours, huit rencontres pour l'Espagne, cent
          quatre pour le tournoi entier. La figure suivante prend le problème sous
          un autre angle, celui du chemin emprunté plutôt que du seul niveau
          affiché.
        </p>
        <figure class="analyse__aside-fig">
          <img class="media-aside__img" src="/photos/wc5.avif"
               alt="Tension d'un match à élimination directe lors de la Coupe du Monde 2026" loading="lazy" decoding="async" />
          <figcaption class="photo__cap mono">Élimination directe · Coupe du Monde 2026</figcaption>
        </figure>
      </div>

      <div class="analyse__block reveal">
        <h3 class="h3 analyse__h">Le parcours d'un favori</h3>
        <div class="prose measure analyse__p">
          <p>
            Être fort ne suffit pas&nbsp;: encore faut-il un tableau qui ne vous
            crucifie pas dès les seizièmes. Le modèle donnait l'Espagne favorite
            dans <em>chacun</em> de ses huit matchs, mais tous n'avaient pas le
            même relief. Contre le Cap-Vert, l'Arabie saoudite puis l'Autriche, la
            probabilité de victoire dépassait 78&nbsp;%&nbsp;: des rencontres où la
            surprise aurait été de perdre. Le vrai test, le seul 50/50 de tout le
            parcours, fut le huitième de finale contre le {closestSpainMatch.opponent}&nbsp;:
            le seul match où le modèle ne lui donnait qu'une mince avance
            ({pct(closestSpainMatch.win_prob)}&nbsp;%). Elle l'a passé 1-0, sur un
            scénario serré, puis n'a plus tremblé jusqu'à la finale.
          </p>
          <p>
            Ce genre de match charnière est ce qui sépare, dans les simulations,
            un tournoi qui se termine en triomphe d'un tournoi qui s'arrête en
            quart de finale. Une défaite ce soir-là contre le Portugal, et c'est
            tout le récit de cette page qui change&nbsp;: plus de finale, plus de
            titre, sans doute un tout autre article. C'est aussi pour cette raison
            que la probabilité de titre, calculée plus bas, ne s'écrit jamais avec
            certitude&nbsp;: elle intègre, par construction, ce genre de bascule
            possible à chaque match du parcours.
          </p>
        </div>
        <p class="figlabel mono">Fig. 3 · Le parcours de l'Espagne, probabilité de victoire (modèle) à chaque tour</p>
        <SpainPath path={spainPath} />
      </div>

      <div class="analyse__block reveal">
        <h3 class="h3 analyse__h">Favorite, et de loin</h3>
        <div class="media-aside media-aside--flow">
          <figure class="analyse__aside-fig">
            <img class="media-aside__img" src="/photos/haaland.avif"
                 alt="Ferveur d'un but décisif lors de la Coupe du Monde 2026" loading="lazy" decoding="async" />
            <figcaption class="photo__cap mono">La joie brute d'un tournoi encore ouvert à tous ses favoris</figcaption>
          </figure>
          <div class="prose analyse__p">
            <p>
              Reste la question ultime&nbsp;: parmi tous les scénarios possibles
              compatibles avec les forces mesurées de chaque équipe, à quelle
              fréquence ce Mondial se termine-t-il avec l'Espagne en haut de
              l'affiche&nbsp;? Pour y répondre, on rejoue le tournoi <strong>10 000
              fois</strong> depuis les seizièmes de finale, chaque match étant tiré
              au sort selon les probabilités que donne le modèle plutôt que rejoué à
              l'identique (le détail de cette simulation, sa logique et son code,
              sont expliqués plus bas). Verdict&nbsp;: l'Espagne termine championne
              <strong> {pct(spainCase.title_prob)} % du temps</strong>, presque un
              tournoi simulé sur deux, et surtout {`${runnerUpRatio}`} fois plus
              souvent que son premier poursuivant dans ce classement, {runnerUp.team_name}.
            </p>
            <p>
              Une précision s'impose, pour ne pas faire dire à ce chiffre plus
              qu'il ne dit&nbsp;: les forces attaque/défense utilisées ici sont
              ajustées sur <strong>les 104 résultats déjà connus</strong>, tournoi
              fini inclus, pas sur la seule phase de groupes, rejouée à
              l'aveugle vers un tournoi encore incertain. Le {pct(spainCase.title_prob)}&nbsp;%
              n'est donc pas un pronostic livré avant le coup d'envoi&nbsp;: c'est
              une lecture <em>a posteriori</em>, qui répond à la question « le
              niveau de jeu affiché sur l'ensemble du tournoi rendait-il ce sacre
              probable » plutôt qu'à « l'aurait-on parié à l'avance ». Les deux
              questions se recoupent (une équipe qui a réellement dominé obtient
              logiquement une probabilité haute), mais elles ne sont pas
              identiques, et seule la seconde serait un vrai test de
              prédictibilité.
            </p>
          </div>
        </div>
        <p class="figlabel mono">Fig. 4 · Probabilité de titre (10 000 tournois simulés, forces estimées sur le tournoi complet)</p>
        <div class="analyse__chart"><BarChart caption="Probabilité de titre" unit="%" items={oddsItems} /></div>
        <div class="prose measure analyse__p analyse__p--after">
          <p>
            On peut aussi suivre cette domination tour par tour plutôt que de la
            résumer à un seul chiffre final. Le graphique suivant affiche, pour
            chaque équipe, la probabilité d'être encore en course à chaque étage du
            tableau&nbsp;: entrée en lice, huitièmes, quarts, demies, finale, puis
            le titre. L'Espagne ne se contente pas de dominer la colonne finale,
            elle domine chaque colonne du tableau depuis le tout premier tour,
            signe que sa supériorité n'est pas apparue en cours de route mais
            qu'elle était déjà présente, selon le modèle, dès l'entame du tournoi.
          </p>
        </div>
        <p class="figlabel figlabel--wide mono">Fig. 5 · Probabilité d'atteindre chaque tour (simulation)</p>
        <ProgressionHeatmap levels={titleProgression.levels} teams={titleProgression.teams} />
      </div>

      <div class="analyse__block reveal">
        <h3 class="h3 analyse__h">Confirmé, à l'échelle du tournoi</h3>
        <div class="prose measure analyse__p">
          <p>
            Le modèle situe l'Espagne au sommet, mais tout ce qui précède reste
            une estimation statistique, jamais un tir observé. Avant de zoomer sur
            l'Espagne seule, on peut déjà confronter ce classement à une première
            réalité, à l'échelle <strong>des 48 équipes</strong>&nbsp;: FBref
            publie, pour chaque sélection, les tirs, les tirs cadrés et le
            <strong>pourcentage d'arrêts</strong> du gardien réellement enregistrés
            sur le tournoi, sans xG&nbsp;: une compétition internationale 2026
            n'en publie pas, seulement des volumes de jeu mesurés.
          </p>
          <p>
            Le test est simple&nbsp;: si la défense du modèle veut dire quelque
            chose, les équipes qu'il classe en tête doivent aussi être celles dont
            le gardien a le plus souvent arrêté ce qui lui arrivait dessus. Le
            nuage ci-dessous met les deux en regard, une équipe par point.
            L'Espagne, meilleure défense du modèle, a{spainHasTopSavePct ? " aussi le meilleur pourcentage d'arrêts réel du tournoi" : " aussi un des meilleurs pourcentages d'arrêts réels du tournoi"}
            ({spainReality.save_pct.toFixed(1)}&nbsp;%)&nbsp;: l'accord n'est pas
            parfait sur les 48 équipes (la donnée ne se plie jamais totalement à
            la théorie), mais la tendance monte bien avec le modèle plutôt que
            de lui tourner le dos.
          </p>
        </div>
        <p class="figlabel mono">Fig. 6 · Défense du modèle × % d'arrêts réel (FBref, 48 équipes)</p>
        <ScatterPlot
          points={realityPts}
          xLabel="Défense (modèle) →"
          yLabel="% d'arrêts réel →"
          yRef={savePctMean}
          caption="Chaque point = une équipe · x = force défensive du modèle · y = pourcentage d'arrêts du gardien, réellement enregistré (FBref) · lignes = équipe moyenne (modèle) et moyenne du plateau (% d'arrêts) · étiquetés : le top 5 défense du modèle"
          ariaLabel="Nuage de points force défensive du modèle contre pourcentage d'arrêts réel mesuré par FBref pour les 48 équipes ; l'Espagne cumule la meilleure défense du modèle et le meilleur pourcentage d'arrêts réel."
        />
        <Takeaway>
          Défense modélisée et % d'arrêts réel sont corrélés
          (<strong>r&nbsp;≈&nbsp;{pearsonR.toFixed(2)}</strong> sur 48 équipes)&nbsp;:
          la tendance confirme le modèle, mais FBref ne mesure que des volumes de
          jeu&nbsp;: <strong>aucun xG</strong> ne circule pour une compétition
          internationale 2026. Ce contrôle-là attendra l'Espagne, seule équipe où
          l'on dispose d'un xG réellement mesuré (plus bas).
        </Takeaway>
      </div>

      <div class="analyse__block reveal">
        <h3 class="h3 analyse__h">Les chiffres réels le confirment</h3>
        <div class="prose measure analyse__p">
          <p>
            Le contrôle FBref porte sur des volumes, 48 équipes, jamais sur du
            xG. Pour l'Espagne, on peut aller plus loin&nbsp;: on dispose
            désormais des <em>vraies</em> données, celles que SofaScore a
            mesurées match par match, et elles ne viennent pas atténuer le
            verdict du modèle&nbsp;: elles l'enfoncent. Sur ses huit rencontres,
            l'Espagne a monopolisé le
            ballon (<strong>51 à 74 % de possession</strong> selon l'adversaire) et
            noyé chacun de ses adversaires sous les occasions. En finale, face à
            l'Argentine&nbsp;: 65 % de possession, <strong>20 tirs contre
            2</strong>, et un <strong><Term def="Buts attendus mesurés tir par tir par SofaScore (données réelles), à distinguer du « xG modèle » que notre modèle déduit des seuls scores.">xG réel</Term> de 2,29 contre 0,22</strong>. Un
            rapport de force qui n'a, à aucun moment de la soirée, laissé planer le
            doute sur l'équipe qui méritait de gagner ce match.
          </p>
        </div>
        <p class="prose measure analyse__p analyse__p--after">
          Encore fallait-il faire dialoguer les deux sources. Elles ne partagent
          <strong>aucun identifiant de match</strong>&nbsp;: pas de clé commune sur
          laquelle faire une jointure classique. On les aligne donc sur la seule
          chose qu'elles ont en partage&nbsp;: les huit matchs de l'Espagne, pris
          dans l'ordre chronologique, avec un appariement <strong>strict, huit contre
          huit</strong> qui fait échouer le build à la moindre divergence de
          nombre, plutôt que de risquer d'apparier deux matchs qui ne se
          correspondent pas.
        </p>
        <p class="figlabel mono">Réconcilier deux sources sans identifiant commun</p>
        <div class="reveal analyse__chart"><SourceMatch /></div>
        <p class="figlabel mono">Fig. 7a · xG réel (SofaScore) et xG du modèle, les huit matchs de l'Espagne</p>
        <div class="reveal analyse__chart"><XgCurve points={xgCurvePts} /></div>
        <p class="figlabel mono">Fig. 7b · Espagne, données réelles par match (SofaScore), xG du modèle en regard</p>
        <div class="realtab mono">
          <div class="realtab__row realtab__head">
            <span>Adversaire</span><span>Poss.</span><span>xG</span><span>xG adv.</span><span>Tirs</span><span class="hide-sm">xG modèle</span>
          </div>
          {spainReal.map((r) => (
            <div class="realtab__row">
              <span class="realtab__opp">{r.opponent}</span>
              <span>{r.possession}%</span>
              <span class="b">{r.xg_for}</span>
              <span>{r.xg_against}</span>
              <span>{r.shots}</span>
              <span class="hide-sm dim">{r.model_xg_for}</span>
            </div>
          ))}
        </div>
        <div class="media-aside media-aside--flow analyse__p--after">
          <figure class="analyse__aside-fig">
            <img class="media-aside__img" src="/photos/portugal.avif"
                 alt="Célébration portugaise lors de la Coupe du Monde 2026" loading="lazy" decoding="async" />
            <figcaption class="photo__cap mono">Huitième de finale · Espagne–Portugal, le seul 50/50 du parcours</figcaption>
          </figure>
          <div class="prose">
            <p>
              Ce tableau permet aussi, en creux, de vérifier le modèle lui-même&nbsp;:
              sa colonne de xG modélisé, calculée sans jamais voir un seul tir, suit
              d'assez près le xG réel mesuré par SofaScore sur la plupart des
              matchs. C'est une forme de validation indépendante, du genre qu'on ne
              peut pas obtenir en n'interrogeant que les résultats bruts. L'écart le
              plus marqué, celui du huitième contre le Portugal, s'explique d'ailleurs
              bien&nbsp;: un match fermé et nerveux, où l'Espagne a créé peu
              d'occasions nettes malgré une possession dominante, exactement le genre
              de match que le modèle, qui ne voit que le score final 1-0, ne peut pas
              anticiper à partir des seuls résultats passés. Et la carte de tirs de la
              finale résume, à elle seule, tout le propos de cette page&nbsp;: un mur
              de frappes espagnoles massées devant le but argentin, une poignée
              seulement dans l'autre sens.
            </p>
          </div>
        </div>
        <p class="figlabel figlabel--wide mono">Fig. 8 · Carte des tirs de l'Espagne, finale (données réelles)</p>
        <Shotmap opponent={spainFinalShots.opponent} shots={spainFinalShots.shots} />
      </div>

      <div class="verdict reveal">
        <p class="verdict__label mono">Le verdict</p>
        <p class="verdict__text">
          Meilleure équipe globale, meilleure défense du tournoi, une
          probabilité de titre de {` ${pct(spainCase.title_prob)} %`} une fois
          le tournoi rejoué 10 000 fois sur son niveau de jeu réel&nbsp;:
          <strong>oui, sur le papier, l'Espagne méritait son
          titre.</strong> Avec la seule nuance honnête que la donnée impose, une
          attaque « seulement » {`#${spainCase.rank_attack}`} et un mince surplus
          de réussite ({`+${spainCase.performance}`} pts). Ni un hold-up, ni une
          supériorité écrasante sur tous les tableaux&nbsp;: une championne solide,
          construite sur l'équilibre plutôt que sur l'éclat d'un seul secteur de
          jeu.
        </p>
      </div>

      <p class="analyse__method mono">
        Méthode, trois sources. <b>football-data.org</b> (scores) alimente le
        modèle de buts (Poisson, maximum de vraisemblance sur {` ${modelMeta.n_matches}`}
        résultats) pour les 48 équipes&nbsp;: là, les « buts attendus » sont
        <b>modélisés</b>. <b>FBref</b> (source #2, 48 équipes) confirme les tirs,
        tirs cadrés et clean sheets réellement enregistrés, jamais de xG&nbsp;:
        une compétition internationale 2026 n'en publie pas. Pour l'Espagne,
        <b>SofaScore</b> (source #3, réconciliée par équipe et par date) fournit
        la possession, les tirs et le <b>xG réel</b> observé. Chaque chiffre de
        cette page est étiqueté selon son origine. Détail complet du modèle plus
        bas, dans la section méthode.
      </p>
    </div>
  </section>

