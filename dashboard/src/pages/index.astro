      <figure class="photo">
        <img class="photo__img" src="/photos/wc8.avif" alt="Ferveur des supporters lors de la Coupe du Monde 2026" loading="lazy" decoding="async" />
        <figcaption class="photo__cap mono">États-Unis · Canada · Mexique · l'été 2026</figcaption>
      </figure>
