---
import Base from "../layouts/Base.astro";
import BracketMatch from "../components/BracketMatch.astro";
import bracket from "../data/bracket.json";
---

<Base title="Phase finale" description="Le tableau final de la Coupe du Monde 2026, des 16es de finale à la finale du 19 juillet.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Phase finale</p>
      <h1 class="h1 intro__title">De trente-deux à un</h1>
      <p class="lede measure intro__lede">
        Le tableau à élimination directe, des 16es de finale à la finale du
        19 juillet. Chaque tour divise le champ par deux&nbsp;: seize, puis
        huit, quatre, deux, un.
      </p>
    </div>
  </section>

  <section class="section bracket-section">
    <div class="wrap">
      <div class="bracket" role="list">
        {bracket.map((round) => (
          <div class="round" role="listitem">
            <div class="round__head">
              <span class="round__label mono">{round.label}</span>
              <span class="round__count mono">{round.matches.length}</span>
            </div>
            <div class="round__cards">
              {round.matches.map((m) => <BracketMatch match={m} />)}
            </div>
          </div>
        ))}
      </div>
    </div>
    <p class="wrap bracket-hint mono">↔ faites défiler pour suivre le tableau</p>
  </section>
</Base>

<style>
  .intro__title { margin-top: 1.2rem; }
  .intro__lede { margin-top: 1.2rem; }
  .bracket-section { overflow: hidden; }

  /* desktop: rounds as columns, horizontally scrollable — the 16→1 funnel */
  .bracket {
    display: flex; gap: clamp(1rem, 2vw, 1.75rem);
    overflow-x: auto; padding-bottom: 1rem;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
  }
  .round {
    flex: 0 0 15.5rem; min-width: 15.5rem;
    scroll-snap-align: start;
  }
  .round__head {
    display: flex; align-items: baseline; justify-content: space-between;
    padding-bottom: 0.6rem; margin-bottom: 0.9rem; border-bottom: 2px solid var(--ink);
  }
  .round__label { font-size: var(--mono-sm); letter-spacing: 0.08em; text-transform: uppercase; }
  .round__count { font-size: var(--mono-sm); color: var(--ink-faint); }
  .round__cards { display: flex; flex-direction: column; gap: 0.75rem; }
  .bracket-hint { margin-top: 0.75rem; font-size: var(--mono-xs); color: var(--ink-faint); letter-spacing: 0.06em; }

  /* mobile: horizontal brackets collapse — stack rounds vertically */
  @media (max-width: 720px) {
    .bracket { flex-direction: column; overflow-x: visible; gap: 2.25rem; }
    .round { flex: 1 1 auto; min-width: 0; width: 100%; }
    .round__cards {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 0.75rem;
    }
    .bracket-hint { display: none; }
  }
</style>
